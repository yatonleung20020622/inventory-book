generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  USER
  ADMIN
}

model User {
  id              String               @id @default(cuid())
  email           String               @unique
  username        String               @default("")
  phone           String               @default("")
  passwordHash    String
  role            Role                 @default(USER)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  items               Item[]
  locations           Location[]
  categories          Category[]
  saleListings        SaleListing[]
  saleComments        SaleListingComment[]
  itemRelations       ItemRelation[]
  itemLocationChanges ItemLocationChange[]
  itemDispositions    ItemDisposition[]
}

model Item {
  id             String         @id @default(cuid())
  name           String
  brand          String         @default("")
  majorColor     String         @default("")
  desc           String         @default("") @db.Text
  quantity       Int            @default(1)
  unit           String         @default("個")
  estimatedPrice String         @default("")
  actualPrice    String         @default("")
  isBox          Boolean        @default(false)
  boxPurpose     String         @default("") @db.Text
  purchaseDate   String         @default("")
  notice         String         @default("") @db.Text
  remarks        String         @default("") @db.Text
  locationId     String?
  location       Location?      @relation(fields: [locationId], references: [id], onDelete: SetNull)
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  saleListings        SaleListing[]
  relationsFrom       ItemRelation[]      @relation("ItemRelationsFrom")
  relationsTo         ItemRelation[]      @relation("ItemRelationsTo")
  categories          ItemCategory[]
  locationChanges     ItemLocationChange[]
  disposition         ItemDisposition?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([userId])
  @@index([locationId])
}

model ItemDisposition {
  id               String   @id @default(cuid())
  itemId           String   @unique
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workingCondition String   @default("") @map("working_condition")
  disposalStatus   String   @default("") @map("disposal_status")
  disposalMethod   String   @default("") @map("disposal_method")
  soldPrice        String   @default("") @map("sold_price")
  disposedAt       String   @default("") @map("disposed_at")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
  @@index([disposalStatus])
  @@map("item_dispositions")
}

model ItemLocationChange {
  id               String   @id @default(cuid())
  itemId           String
  item             Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromLocationId   String?
  toLocationId     String?
  fromLocationName String   @default("")
  toLocationName   String   @default("")
  createdAt        DateTime @default(now())

  @@index([itemId])
  @@index([userId])
  @@index([createdAt])
}

model Category {
  id                String             @id @default(cuid())
  name              String
  color             String             @default("")
  userId            String
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  items             ItemCategory[]
  declutterListings DeclutterListing[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

model ItemCategory {
  itemId     String
  item       Item     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([itemId, categoryId])
  @@index([categoryId])
}

model ItemRelation {
  id         String   @id @default(cuid())
  fromItemId String
  fromItem   Item     @relation("ItemRelationsFrom", fields: [fromItemId], references: [id], onDelete: Cascade)
  toItemId   String
  toItem     Item     @relation("ItemRelationsTo", fields: [toItemId], references: [id], onDelete: Cascade)
  type       String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([fromItemId, toItemId, type])
  @@index([fromItemId])
  @@index([toItemId])
  @@index([userId])
}

model SaleListing {
  id           String               @id @default(cuid())
  itemId       String
  item         Item                 @relation(fields: [itemId], references: [id], onDelete: Cascade)
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String               @default("")
  brand        String               @default("")
  quantity     Int                  @default(1)
  unit         String               @default("個")
  desc         String               @default("") @db.Text
  notice       String               @default("") @db.Text
  purchaseDate String               @default("")
  condition    String               @default("")
  isVirtual    Boolean              @default(false)
  salePrice    String               @default("")
  note         String               @default("") @db.Text
  comments     SaleListingComment[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([userId, itemId])
  @@index([userId])
  @@index([itemId])
}

model SaleListingComment {
  id        String      @id @default(cuid())
  listingId String
  listing   SaleListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  body      String      @db.Text
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([listingId])
  @@index([userId])
}

model Location {
  id        String   @id @default(cuid())
  name      String
  address   String   @default("") @db.Text
  lat       String   @default("")
  lon       String   @default("")
  isExpired Boolean  @default(false) @map("is_expired")
  isDefault Boolean  @default(false) @map("is_default")
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     Item[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@map("locations")
}

model TravelGroup {
  id        String        @id @default(cuid())
  name      String
  color     String        @default("")
  places    TravelPlace[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([name])
  @@map("travel_groups")
}

model TravelPlace {
  id        String        @id @default(cuid())
  name      String
  address   String        @default("") @db.Text
  lat       Float
  lon       Float
  groupId   String?
  group     TravelGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  visits    TravelVisit[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([groupId])
  @@map("travel_places")
}

model TravelVisit {
  id         String      @id @default(cuid())
  placeId    String
  place      TravelPlace @relation(fields: [placeId], references: [id], onDelete: Cascade)
  visitedAt  String
  notes      String      @default("") @db.Text
  companions String      @default("") @db.Text
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([placeId])
  @@map("travel_visits")
}

enum TravelPlanItemStatus {
  IDEA
  RESEARCHING
  BOOKED
  SKIPPED
}

model TravelPlan {
  id        String           @id @default(cuid())
  title     String
  summary   String           @default("") @db.Text
  startDate String           @default("")
  endDate   String           @default("")
  notes     String           @default("") @db.Text
  items     TravelPlanItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([startDate])
  @@map("travel_plans")
}

model TravelPlanItem {
  id        String                @id @default(cuid())
  planId    String
  plan      TravelPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  title     String
  notes     String                @default("") @db.Text
  url       String                @default("")
  status    TravelPlanItemStatus  @default(IDEA)
  startDate String                @default("")
  endDate   String                @default("")
  cost      String                @default("")
  sortOrder Int                   @default(0)
  createdAt DateTime              @default(now())
  updatedAt DateTime              @updatedAt

  @@index([planId])
  @@index([status])
  @@index([sortOrder])
  @@map("travel_plan_items")
}

model CvProfile {
  id             String         @id @default(cuid())
  displayName    String
  headline       String         @default("")
  summary        String         @default("") @db.Text
  phone          String         @default("")
  whatsapp       String         @default("")
  email          String         @default("")
  websiteLabel   String         @default("")
  websiteUrl     String         @default("")
  ctaTitle       String         @default("")
  ctaBody        String         @default("") @db.Text
  ctaButtonLabel String         @default("")
  footerText     String         @default("") @db.Text
  published      Boolean        @default(true)
  experiences    CvExperience[]
  educations     CvEducation[]
  skillGroups    CvSkillGroup[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("cv_profile")
}

model CvExperience {
  id         String    @id @default(cuid())
  profileId  String
  profile    CvProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  company    String
  role       String
  summary    String    @default("") @db.Text
  bullets    String    @default("[]") @db.Text
  companyUrl String    @default("")
  sortOrder  Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([profileId])
  @@map("cv_experiences")
}

model CvEducation {
  id        String    @id @default(cuid())
  profileId String
  profile   CvProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  school    String
  degree    String
  detail    String    @default("") @db.Text
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([profileId])
  @@map("cv_educations")
}

model CvSkillGroup {
  id        String    @id @default(cuid())
  profileId String
  profile   CvProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  title     String
  items     String    @default("[]") @db.Text
  sortOrder Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([profileId])
  @@map("cv_skill_groups")
}

enum DeclutterStatus {
  AVAILABLE
  RESERVED
  GONE
  HIDDEN
}

model DeclutterListing {
  id           String          @id @default(cuid())
  title        String
  description  String          @default("") @db.Text
  condition    String          @default("")
  price        String          @default("")
  locationNote String          @default("")
  contactNote  String          @default("")
  status       DeclutterStatus @default(AVAILABLE)
  sortOrder    Int             @default(0)
  categoryId   String?
  category     Category?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([categoryId])
  @@index([status])
  @@index([sortOrder])
  @@map("declutter_listings")
}

enum TrainSessionStatus {
  IN_PROGRESS
  COMPLETED
}

model TrainExercise {
  id               String                 @id @default(cuid())
  name             String                 @unique
  defaultRestSec   Int                    @default(60)
  notes            String                 @default("") @db.Text
  sortOrder        Int                    @default(0)
  sessionExercises TrainSessionExercise[]
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  @@index([sortOrder])
  @@map("train_exercises")
}

model TrainSession {
  id         String              @id @default(cuid())
  title      String              @default("")
  startedAt  DateTime
  finishedAt DateTime?
  status     TrainSessionStatus  @default(IN_PROGRESS)
  notes      String              @default("") @db.Text
  exercises  TrainSessionExercise[]
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@index([startedAt])
  @@index([status])
  @@map("train_sessions")
}

model TrainSessionExercise {
  id            String        @id @default(cuid())
  sessionId     String
  session       TrainSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  exerciseId    String
  exercise      TrainExercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)
  sortOrder     Int           @default(0)
  targetRestSec Int           @default(60)
  sets          TrainSet[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([sessionId])
  @@index([exerciseId])
  @@map("train_session_exercises")
}

model TrainSet {
  id                String               @id @default(cuid())
  sessionExerciseId String
  sessionExercise   TrainSessionExercise @relation(fields: [sessionExerciseId], references: [id], onDelete: Cascade)
  setIndex          Int
  reps              Int                  @default(0)
  durationSec       Int                  @default(0)
  restAfterSec      Int                  @default(0)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([sessionExerciseId, setIndex])
  @@index([sessionExerciseId])
  @@map("train_sets")
}
