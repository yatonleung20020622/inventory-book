AUTH_SECRET="generate-a-long-random-string"
DATABASE_URL="mysql://root@127.0.0.1:3306/inventory_book"
DATABASE_NAME="inventory_book"
# Use host.docker.internal when the app runs in Docker and MariaDB is on the host
DATABASE_HOST="127.0.0.1"
DATABASE_PORT="3306"
DATABASE_USER="root"
DATABASE_PASSWORD=""
# Set true for cloud DBs that require TLS (ssl-mode=REQUIRED)
DATABASE_SSL="false"
# Seed login users always with `npm run db:seed`.
# Set true (or use `npm run db:seed:demo`) to also create fake demo inventory.
SEED_DEMO="false"
# Set true with SEED_DEMO to wipe and recreate previous demo inventory.
SEED_RESET="false"
